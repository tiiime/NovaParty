{
  "version": "0.3",
  "status": "design_proposal_not_runtime_theme",
  "brand": "星星大作战",
  "color": {
    "surface.page": "#EEF4FF",
    "surface.panel": "#FFFFFF",
    "brand.star": "#FFE34B",
    "text.primary": "#133464",
    "text.secondary": "#506786",
    "focus.ring": "#FF8A1C",
    "border.default": "#D6E4F8",
    "state.success": "#087658",
    "state.success.surface": "#E1FFF4",
    "state.error": "#AB3558",
    "state.error.surface": "#FFF0F6",
    "state.working.surface": "#EAF3FC",
    "state.waiting.surface": "#FFF4D6",
    "button.primary.pressed": "#F4BE25",
    "button.primary.busy": "#FFF2A8",
    "button.disabled.fill": "#E1EAF0",
    "button.disabled.text": "#8294A3",
    "button.shadow.primary": "#C58A0F",
    "button.shadow.secondary": "#BCD2F0",
    "brand.sky": "#2058E0",
    "focus.halo": "#FF8A1C",
    "accent.pink": "#FF75B9",
    "accent.mint": "#49DFCB",
    "accent.purple": "#B99AFF",
    "text.on_brand": "#FFFFFF",
    "surface.brand": "#2058E0",
    "focus.outline": "#263461",
    "focus.inner": "#FFF5CE"
  },
  "sky": {
    "driver": "device_local_time",
    "interpolation": "cyclic_linear_between_local_hour_anchors",
    "anchors": [
      {
        "hour": 6,
        "top": "#234BE0",
        "bottom": "#3A78ED"
      },
      {
        "hour": 12,
        "top": "#183CD4",
        "bottom": "#286DE9"
      },
      {
        "hour": 18,
        "top": "#393FD2",
        "bottom": "#5369E6"
      },
      {
        "hour": 0,
        "top": "#2639BD",
        "bottom": "#4960D9"
      }
    ],
    "affects": [
      "lobby_background",
      "decorative_clouds"
    ],
    "keeps_stable": [
      "text",
      "panel",
      "button",
      "focus",
      "game_state_colors",
      "white_text_backplates"
    ]
  },
  "type": {
    "family": "Noto Sans SC",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "mobile": {
      "title": [
        28,
        36
      ],
      "section": [
        22,
        30
      ],
      "body": [
        17,
        26
      ],
      "label": [
        16,
        24
      ],
      "meta": [
        14,
        20
      ]
    },
    "tv": {
      "title": [
        40,
        52
      ],
      "section": [
        30,
        40
      ],
      "body": [
        24,
        34
      ],
      "label": [
        24,
        32
      ],
      "meta": [
        20,
        28
      ]
    }
  },
  "space": [
    4,
    8,
    12,
    16,
    24,
    32,
    48
  ],
  "radius": {
    "input": 12,
    "button": 999,
    "card": 28,
    "panel": 32,
    "pill": 999
  },
  "size": {
    "button_height": {
      "mobile": 52,
      "tv": 64
    },
    "minimum_hit_target": {
      "mobile": 48,
      "tv": 64
    },
    "focus_ring_width": 6,
    "focus_ring_offset": 3,
    "icon_canvas": 24,
    "icon_stroke": 2.5,
    "button_shadow_offset_y": 8,
    "button_pressed_offset_y": 4,
    "tv_safe_inset": 48
  },
  "motion_ms": {
    "press": [
      60,
      60
    ],
    "focus_and_panel": [
      150,
      160
    ],
    "celebration_once": [
      450,
      650
    ]
  },
  "accessibility": {
    "sound_can_disable": true,
    "reduce_motion": true,
    "normal_text_contrast_target": 4.5
  },
  "reference_canvas": {
    "mobile": [
      390,
      844
    ],
    "tv": [
      1280,
      720
    ]
  },
  "direction": "星星派对 / glossy toy space",
  "material": {
    "button": "rounded capsule with top highlight and lower extrusion",
    "character": "inflated yellow star with soft highlight",
    "surface": "white toy shell with cool blue lower edge",
    "shadow_offset_y": 8,
    "pressed_offset_y": 4
  },
  "decoration": {
    "ambient_motion": false,
    "confetti_placement": "periphery only",
    "max_visible_confetti_per_screen": 12,
    "burst_once_on": [
      "room_created",
      "friends_ready",
      "match_won"
    ],
    "never_cover": [
      "text",
      "focus_ring",
      "board",
      "hand",
      "primary_action"
    ]
  },
  "focus_feedback": {
    "runtime": "0.1.12 UI update",
    "button_scale": 1.045,
    "card_scale": 1.035,
    "hover_scale": 1.015,
    "halo_hz": 0.65,
    "reduce_motion": "static scale and ring, no transition or halo pulse"
  }
}
