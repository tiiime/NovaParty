{
  "version": "0.4",
  "status": "runtime_source",
  "brand": "星星大作战",
  "direction": "果冻星星 / juicy flat: 纯色块、2 单位描边、4 单位厚底边，按下整体下沉",
  "reference": "Duolingo Android 界面的结构特征（厚底边 4、描边 2、4 的倍数间距、粗圆字重）；配色、星星与全部图形为本项目原创",
  "color": {
    "sky": "#2058E0",
    "sky.lip": "#123CA9",
    "sky.soft": "#E1EFFF",
    "star": "#FFE34B",
    "star.lip": "#E0A612",
    "star.soft": "#FFF4B8",
    "ink": "#133464",
    "muted": "#506786",
    "page": "#EEF4FF",
    "panel": "#FFFFFF",
    "line": "#D6E4F8",
    "line.lip": "#BCD2F0",
    "disabled": "#E1EAF0",
    "disabled.text": "#8294A3",
    "success": "#087658",
    "success.soft": "#E1FFF4",
    "success.line": "#8FDDC2",
    "danger": "#AB3558",
    "danger.soft": "#FFF0F6",
    "danger.line": "#F0B3C8",
    "focus": "#FF8A1C",
    "focus.outline": "#263461",
    "focus.inner": "#FFF5CE",
    "pink": "#FF75B9",
    "mint": "#49DFCB",
    "purple": "#B99AFF",
    "white": "#FFFFFF",
    "scrim": "#06143D"
  },
  "sky_anchors": [
    {
      "hour": 0,
      "top": "#2639BD",
      "bottom": "#4960D9"
    },
    {
      "hour": 6,
      "top": "#234BE0",
      "bottom": "#3A78ED"
    },
    {
      "hour": 12,
      "top": "#183CD4",
      "bottom": "#286DE9"
    },
    {
      "hour": 18,
      "top": "#393FD2",
      "bottom": "#5369E6"
    }
  ],
  "metric": {
    "grid": 4,
    "stroke": 2,
    "lip": 4,
    "radius.button": 16,
    "radius.card": 20,
    "radius.sheet": 24,
    "radius.input": 14,
    "radius.chip": 999,
    "button.height": 64,
    "button.height.large": 80,
    "button.height.small": 52,
    "hit.min": 48,
    "row.height": 68,
    "switch.width": 64,
    "switch.height": 36,
    "progress.height": 20,
    "focus.ring": 6,
    "page.margin": 24,
    "tv.safe": 48
  },
  "type": {
    "family": "Noto Sans SC",
    "weight.body": 500,
    "weight.label": 700,
    "weight.title": 800,
    "size.display": 48,
    "size.title": 32,
    "size.section": 24,
    "size.button": 24,
    "size.body": 22,
    "size.meta": 18,
    "note": "逻辑单位。手机画布 540×960，电视 1280×720。"
  },
  "motion_ms": {
    "press": 80,
    "release": 120,
    "focus": 150,
    "page": 160,
    "sheet": 200,
    "celebrate": 500
  },
  "focus_feedback": {
    "button_scale": 1.045,
    "card_scale": 1.035,
    "hover_scale": 1.015,
    "halo_hz": 0.65
  },
  "haptic": {
    "tap": {
      "ms": 12,
      "amplitude": 0.35,
      "use": "任何按钮按下、开关切换"
    },
    "select": {
      "ms": 18,
      "amplitude": 0.5,
      "use": "选中游戏、角色、配色"
    },
    "confirm": {
      "ms": 28,
      "amplitude": 0.8,
      "use": "启动游戏、保存、加入成功"
    },
    "warn": {
      "ms": 40,
      "amplitude": 1.0,
      "use": "失败、被拒绝的操作"
    },
    "rules": "仅手机生效；电视与桌面忽略。设置可关闭；与音效互相独立。方向键移动焦点不震动。"
  },
  "button": {
    "primary": {
      "fill": "star",
      "lip": "star.lip",
      "text": "ink",
      "border": null
    },
    "accent": {
      "fill": "sky",
      "lip": "sky.lip",
      "text": "white",
      "border": null
    },
    "secondary": {
      "fill": "panel",
      "lip": "line.lip",
      "text": "sky",
      "border": "line.lip"
    },
    "danger": {
      "fill": "panel",
      "lip": "danger.line",
      "text": "danger",
      "border": "danger.line"
    },
    "disabled": {
      "fill": "disabled",
      "lip": null,
      "text": "disabled.text",
      "border": null
    }
  },
  "accessibility": {
    "text_contrast_min": 4.5,
    "sound_can_disable": true,
    "haptics_can_disable": true,
    "reduce_motion": true
  }
}
