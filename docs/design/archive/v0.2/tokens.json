{
  "version": "0.2",
  "status": "design_proposal_not_runtime_theme",
  "brand": "星星大作战",
  "color": {
    "surface.page": "#EAF7FF",
    "surface.panel": "#FFFFFF",
    "brand.star": "#FFE84D",
    "text.primary": "#173653",
    "text.secondary": "#4D6A80",
    "focus.ring": "#2469AD",
    "border.default": "#CBDDE9",
    "state.success": "#246F5A",
    "state.success.surface": "#E7F3ED",
    "state.error": "#AE4250",
    "state.error.surface": "#FFF0F1",
    "state.working.surface": "#EAF3FC",
    "state.waiting.surface": "#FFF4D6",
    "button.primary.pressed": "#E2C937",
    "button.primary.busy": "#FFF1A0",
    "button.disabled.fill": "#E1EAF0",
    "button.disabled.text": "#8294A3",
    "button.shadow.primary": "#D4BA37",
    "button.shadow.secondary": "#ADC5D5"
  },
  "sky": {
    "driver": "device_local_time",
    "interpolation": "cyclic_linear_between_local_hour_anchors",
    "anchors": [
      {"hour": 6, "top": "#9ACBFF", "bottom": "#F1F8FF"},
      {"hour": 12, "top": "#82B9FF", "bottom": "#EDF6FF"},
      {"hour": 18, "top": "#9DADE9", "bottom": "#F1F1FC"},
      {"hour": 0, "top": "#93A3D5", "bottom": "#EDF1FB"}
    ],
    "affects": ["lobby_background", "decorative_clouds"],
    "keeps_stable": ["text", "panel", "button", "focus", "game_state_colors"]
  },
  "type": {
    "family": "Noto Sans SC",
    "weights": {"regular": 400, "medium": 500, "semibold": 600, "bold": 700},
    "mobile": {"title": [28, 36], "section": [22, 30], "body": [17, 26], "label": [16, 24], "meta": [14, 20]},
    "tv": {"title": [40, 52], "section": [30, 40], "body": [24, 34], "label": [24, 32], "meta": [20, 28]}
  },
  "space": [4, 8, 12, 16, 24, 32, 48],
  "radius": {"input": 12, "button": 18, "card": 24, "panel": 28, "pill": 999},
  "size": {
    "button_height": {"mobile": 52, "tv": 64},
    "minimum_hit_target": {"mobile": 48, "tv": 64},
    "focus_ring_width": 4,
    "focus_ring_offset": 4,
    "icon_canvas": 24,
    "icon_stroke": 2.5,
    "button_shadow_offset_y": 4,
    "button_pressed_offset_y": 2,
    "tv_safe_inset": 48
  },
  "motion_ms": {"press": [100, 140], "focus_and_panel": [180, 240], "celebration_once": [280, 420]},
  "accessibility": {"sound_can_disable": true, "reduce_motion": true, "normal_text_contrast_target": 4.5},
  "reference_canvas": {"mobile": [390, 844], "tv": [1280, 720]}
}
