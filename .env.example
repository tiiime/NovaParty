# Copy to .env and fill in your own settings. Do not commit .env.
# Python development tools load .env automatically; CLI arguments take priority.
# Use quotes around paths containing spaces. Values are literal (no $ expansion).

# Optional executable paths. Empty values use PATH / platform defaults.
GODOT=
ADB=
# Optional Android SDK path used to locate adb when ADB is empty.
ANDROID_HOME=

# Physical Android phone: adb devices
ANDROID_SERIAL=
# TV wireless adb endpoint or USB serial; never put your real value here.
TV_ADB_SERIAL=
TV_ADB_PORT=5037

# Generic emulator selector and iOS simulator selector (or your own UDID in .env).
ANDROID_EMULATOR_SERIAL=emulator-5554
IOS_SIMULATOR_DEVICE=booted
